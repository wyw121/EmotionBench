[
  {"id": "metaphor_001", "text": "他的回复像冬天的铁门。", "label": "negative", "type": "metaphor", "difficulty": "hard", "context": "回复冷淡"},
  {"id": "metaphor_002", "text": "她的笑容像春天的阳光。", "label": "positive", "type": "metaphor", "difficulty": "medium", "context": "描述温暖感受"},
