[
  {
    "id": "metaphor_001",
    "text": "她的笑容像春天的阳光。",
    "label": "positive",
    "type": "metaphor",
    "difficulty": "hard",
    "context": "温暖感受"
  },
  {
    "id": "metaphor_002",
    "text": "那句鼓励像一盏灯，照亮了我的路。",
    "label": "positive",
    "type": "metaphor",
    "difficulty": "hard",
    "context": "被鼓励"
  },
  {
    "id": "metaphor_003",
    "text": "他的支持像一阵顺风，把我推向前方。",
    "label": "positive",
    "type": "metaphor",
    "difficulty": "hard",
    "context": "支持带来帮助"
  },
  {
    "id": "metaphor_004",
    "text": "这个想法像打开了一扇窗。",
    "label": "positive",
    "type": "metaphor",
    "difficulty": "hard",
    "context": "灵感涌现"
  },
  {
    "id": "metaphor_005",
    "text": "老师的点评像一把钥匙，帮我找到了答案。",
