# OpenAI / GPT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# DeepSeek (OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
