# Generic OpenAI-compatible proxy (e.g. Gemini reverse proxy)
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=https://your-proxy-domain/v1
COMPATIBLE_MODEL=

# SiliconFlow API
